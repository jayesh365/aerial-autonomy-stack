<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zmq_bridge_py</name>
  <version>0.1.0</version>
  <description>Python ZMQ Bridge for Gazebo and ROS 2</description>
  <maintainer email="jacopo.pan@gmail.com">JacopoPan</maintainer>
